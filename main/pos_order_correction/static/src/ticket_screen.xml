<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_order_correction.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='_selectedSyncedOrder?.getOrderlines()?.length and !this.pos.scanning']" position="attributes">
            <attribute name="t-if">getCorrectionRefundLines(_selectedSyncedOrder).length and !this.pos.scanning</attribute>
        </xpath>
        <xpath expr="//div[@t-if='isOrderSynced'][hasclass('text-center')]" position="before">
            <div t-if="_selectedSyncedOrder?.correction_has_applied" class="alert alert-info mb-0 py-2">
                Current corrected sale. Printing retains the original receipt.
                <span t-if="_selectedSyncedOrder.correction_pending"> Close the correction session before returning products.</span>
            </div>
        </xpath>
    </t>
    <t t-name="pos_order_correction.CorrectionOrderDisplay" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('order-summary')]" position="attributes">
            <attribute name="t-if">props.mode !== 'receipt' and !order.correction_has_applied</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-summary')]" position="after">
            <div t-if="order.correction_has_applied" class="order-summary d-flex flex-column gap-1 p-2 border-bottom fw-bolder">
                <div class="d-flex justify-content-between fs-6 text-muted">
                    <span>Taxes</span><span t-esc="formatCurrency(order.correction_current_tax)"/>
                </div>
                <div class="d-flex justify-content-between fs-3">
                    <span>Total</span><span t-esc="formatCurrency(order.correction_current_total)"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
