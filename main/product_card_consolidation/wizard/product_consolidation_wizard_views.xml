<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_consolidation_wizard_form" model="ir.ui.view">
        <field name="name">product.consolidation.wizard.form</field>
        <field name="model">product.consolidation.wizard</field>
        <field name="arch" type="xml">
            <form string="Consolidate Product Cards">
                <field name="state" invisible="1"/>
                <field name="has_blockers" invisible="1"/>
                <group invisible="state != 'preview'">
                    <field name="product_template_ids" widget="many2many_tags" readonly="1"/>
                    <field name="canonical_template_id" domain="[('id', 'in', product_template_ids)]"/>
                    <field name="duplicate_template_id" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="state != 'confirm'">
                    The duplicate product card will be archived. Historical documents will continue to open that archived card. This operation must be reviewed before confirmation.
                </div>
                <group invisible="state != 'confirm'">
                    <field name="canonical_template_id" readonly="1"/>
                    <field name="duplicate_template_id" readonly="1"/>
                </group>
                <field name="preview_line_ids" nolabel="1" readonly="1">
                    <list decoration-danger="severity == 'blocker'" decoration-info="severity == 'transfer'" decoration-muted="severity == 'preserve'">
                        <field name="severity"/>
                        <field name="category"/>
                        <field name="count"/>
                        <field name="message"/>
                    </list>
                </field>
                <footer>
                    <button name="action_preview" type="object" string="Refresh Preview" class="btn-secondary" invisible="state != 'preview'"/>
                    <button name="action_request_confirmation" type="object" string="Continue" class="btn-primary" invisible="state != 'preview' or has_blockers"/>
                    <button name="action_back_to_preview" type="object" string="Back" class="btn-secondary" invisible="state != 'confirm'"/>
                    <button name="action_confirm" type="object" string="Archive Duplicate and Consolidate" class="btn-danger" invisible="state != 'confirm'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_consolidation_wizard" model="ir.actions.act_window">
        <field name="name">Consolidate Product Cards</field>
        <field name="res_model">product.consolidation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_product_consolidation_bound" model="ir.actions.server">
        <field name="name">Consolidate Product Cards</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[Command.link(ref('product_card_consolidation.group_product_consolidation_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ir.actions.actions']._for_xml_id('product_card_consolidation.action_product_consolidation_wizard')</field>
    </record>
</odoo>
