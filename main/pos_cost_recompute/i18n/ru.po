#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "Stock repairs cannot be applied while the module is being removed."
msgstr "Нельзя применять исправления склада во время удаления модуля."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "Stock sources must belong to the operation company."
msgstr "Складские источники должны принадлежать компании операции."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "Stock value: %(old)s → %(new)s"
msgstr "Складская оценка: %(old)s → %(new)s"

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "The proposed stock value must be positive and finite."
msgstr ""
"Предлагаемая складская оценка должна быть положительным конечным числом."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "The receipt has no positive finite recorded value."
msgstr "У поступления нет положительной конечной оценки."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_move.py:0
msgid "The repaired movement requires a separate traceable correction."
msgstr ""
"Исправленное движение требует отдельной корректировки с сохранением истории."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "The stock issue or POS order belongs to a locked period."
msgstr "Складское списание или чек POS относятся к заблокированному периоду."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/pos_cost_recompute_stock_line.py:0
msgid "The stock repair preview is stale."
msgstr "Предварительный просмотр исправления склада устарел."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid ""
"The supplier receipt must strictly precede the issue in the same storage "
"location."
msgstr ""
"Поступление от поставщика должно быть строго раньше списания и в то же место"
" хранения."

#. module: pos_cost_recompute
#: model_terms:ir.ui.view,arch_db:pos_cost_recompute.pos_cost_recompute_view_form
msgid ""
"This changes historical stock valuation using the receipt's current recorded value.\n"
"                            It does not prove that FIFO applied at the sale date.\n"
"                            Supplier billing may change the source later; applied repairs will not update automatically."
msgstr ""
"Историческая складская оценка изменяется по текущей оценке поступления. Это "
"не доказывает, что FIFO действовал на дату продажи. Счета поставщика могут "
"позже изменить источник; применённое исправление автоматически не обновится."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid ""
"This corrects historical valuation using the receipt's current recorded "
"value. It does not prove FIFO applied at the sale date. Supplier billing may"
" still change the receipt value; later changes will not update this repair "
"automatically."
msgstr ""
"Историческая оценка исправляется по текущей оценке поступления. Это не "
"доказывает, что FIFO действовал на дату продажи. Счета поставщика могут "
"изменить оценку поступления; исправление автоматически не обновится."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "This movement already has a stock repair."
msgstr "Для этого движения уже применено исправление складской оценки."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_move.py:0
msgid ""
"This movement has a reviewed stock cost repair. Changing its value or stock "
"dimensions requires a separate traceable correction."
msgstr ""
"Для движения применено просмотренное исправление оценки. Изменение его "
"стоимости или складских параметров требует отдельной корректировки с "
"сохранением истории."

#. module: pos_cost_recompute
#. odoo-python
#: code:addons/pos_cost_recompute/models/stock_repair.py:0
msgid "Unresolved financial or analytic effects prevent stock repair."
msgstr ""
"Неопределённые бухгалтерские или аналитические последствия не позволяют "
"исправить складскую оценку."

#. module: pos_cost_recompute
#: model:ir.model.fields,field_description:pos_cost_recompute.field_pos_cost_recompute_stock_line__warning
msgid "Warning"
msgstr "Предупреждение"
