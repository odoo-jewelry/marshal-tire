<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_historical_stock" model="res.groups.privilege">
        <field name="name">Historical POS Stock</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_historical_stock" model="res.groups">
        <field name="name">Manage Historical Stock Write-offs</field>
        <field name="privilege_id" ref="privilege_historical_stock"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
