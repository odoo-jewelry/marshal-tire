#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"%(product)s requires untracked company-owned stock with FIFO and periodic "
"valuation."
msgstr ""
"Для товара %(product)s поддерживаются собственные запасы без партий и "
"серийных номеров, метод FIFO и периодическая оценка."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/cost_recompute.py:0
msgid ""
"A complete stock source is required for historical POS cost recomputation."
msgstr ""
"Для пересчёта себестоимости чека нужны полностью проведённые складские "
"движения."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "A lot or serial number is required for this stock product."
msgstr "Для этого товара необходимо указать партию или серийный номер."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/pos_order.py:0
msgid ""
"A receipt used for historical stock consumption cannot accept a payment."
msgstr "Чек, использованный для исторического списания, нельзя оплатить."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/pos_order.py:0
msgid ""
"A receipt used for historical stock consumption cannot create another "
"payment, delivery or return."
msgstr ""
"Чек, использованный для исторического списания, нельзя повторно оплатить, "
"отгрузить или вернуть."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Access to the complete stock history is required."
msgstr "Необходим доступ ко всей складской истории."

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__historical_applied_at
msgid "Applied At"
msgstr "Дата выполнения"

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__historical_applied_by_id
msgid "Applied By"
msgstr "Выполнил"

#. module: pos_historical_stock_writeoff
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.stock_picking_historical_form
msgid "Apply Historical Stock"
msgstr "Провести списание"

#. module: pos_historical_stock_writeoff
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.historical_cost_recompute_form
msgid "Apply Historical Stock and POS Costs"
msgstr "Применить себестоимость склада и чеков"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Apply historical documents individually."
msgstr "Проводите исторические списания по одному."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/cost_recompute.py:0
msgid "Audited historical stock values cannot be deleted."
msgstr "Складские оценки с сохранённой историей пересчёта нельзя удалять."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/pos_order.py:0
msgid ""
"Cancel historical preparation before changing or processing its source "
"receipt. Completed historical consumption cannot be reused as a sale."
msgstr ""
"Перед изменением или проведением исходного чека отмените подготовку "
"исторического списания. После проведения списания чек нельзя использовать "
"для продажи."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Completed historical consumption cannot be cancelled."
msgstr "Проведённое историческое списание нельзя отменить."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Completed historical documents cannot be deleted."
msgstr "Проведённые исторические списания нельзя удалять."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_integrity.py:0
msgid "Completed historical stock movements cannot be changed."
msgstr "Проведённые исторические складские движения нельзя изменять."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Completed or cancelled historical documents cannot be edited."
msgstr ""
"Проведённые или отменённые исторические списания нельзя редактировать."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Consolidated product history requires separate review."
msgstr "История объединённых товаров требует отдельной проверки."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Current unreserved stock is insufficient for %(product)s."
msgstr "Недостаточно текущего свободного остатка товара %(product)s."

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_cost_recompute__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_order__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_order_line__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_payment__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_session__display_name
