#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_pos_order
msgid "Point of Sale Orders"
msgstr "Кассовые заказы"

#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_pos_payment
msgid "Point of Sale Payments"
msgstr "Кассовые оплаты"

#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_pos_session
msgid "Point of Sale Session"
msgstr "Кассовая смена"

#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_stock_move_line
msgid "Product Moves (Stock Move Line)"
msgstr "Строки складских движений"

#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_product_value
msgid "Product Value"
msgstr "Стоимость товара"

#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_product_product
msgid "Product Variant"
msgstr "Вариант товара"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Provide a reason and at least one stock line."
msgstr "Укажите основание и добавьте хотя бы одну строку товара."

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__historical_reason
msgid "Reason"
msgstr "Основание"

#. module: pos_historical_stock_writeoff
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.stock_picking_historical_form
msgid "Recompute Subsequent Costs"
msgstr "Пересчитать последующую себестоимость"

#. module: pos_historical_stock_writeoff
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.historical_cost_recompute_form
msgid ""
"Recompute all subsequent issues of the affected products from the earliest "
"selected historical document, including nonzero costs. Stock values are "
"updated first, followed by related completed POS costs. Revenue, payments "
"and quantities remain unchanged."
msgstr ""
"Пересчитываются все последующие расходы затронутых товаров от самого раннего"
" выбранного исторического документа, включая ненулевую стоимость. Сначала "
"обновляется складская оценка, затем себестоимость связанных проведённых "
"чеков. Выручка, оплаты и количества сохраняются."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"Recorded movements do not reconcile with current stock for %(product)s."
msgstr ""
"Записанные движения не соответствуют текущему остатку товара %(product)s."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"Returns, transfers or previously repaired stock require separate valuation "
"review."
msgstr ""
"Возвраты, внутренние перемещения и ранее исправленные складские оценки "
"требуют отдельной проверки стоимости."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Saving historical preparation must not reserve stock."
msgstr ""
"Сохранение подготовки исторического списания не должно резервировать товар."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Select a closed session and a stock operation date in the past."
msgstr "Выберите закрытую смену и укажите дату и время списания в прошлом."

