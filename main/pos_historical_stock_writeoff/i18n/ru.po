#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_move_line__id
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__id
msgid "ID"
msgstr "ID"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"Insufficient historical stock for %(product)s: available %(available)s, "
"required %(required)s."
msgstr ""
"Недостаточно исторического остатка товара %(product)s: доступно "
"%(available)s, требуется %(required)s."

#. module: pos_historical_stock_writeoff
#: model:res.groups,name:pos_historical_stock_writeoff.group_historical_stock
msgid "Manage Historical Stock Write-offs"
msgstr "Управление историческими списаниями"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Only draft historical documents can be applied."
msgstr "Провести можно только черновик исторического списания."

#. module: pos_historical_stock_writeoff
#: model:ir.model.constraint,message:pos_historical_stock_writeoff.constraint_stock_picking_historical_active_source
msgid "Only one active historical stock document is allowed per receipt."
msgstr ""
"Для чека допускается только одна активная подготовка или проведённое "
"историческое списание."

#. module: pos_historical_stock_writeoff
#: model:ir.model,name:pos_historical_stock_writeoff.model_pos_cost_recompute
msgid "POS Cost Recomputation"
msgstr "Пересчёт себестоимости чеков"

