#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_product_value__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_move__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_move_line__display_name
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__display_name
msgid "Display Name"
msgstr "Отображаемое имя"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"Equal receipt and issue timestamps make historical valuation ambiguous."
msgstr ""
"Совпадающее время прихода и расхода не позволяет однозначно определить "
"историческую стоимость."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"Existing accounting or analytic entries prevent historical stock valuation "
"changes."
msgstr ""
"Существующие бухгалтерские или аналитические записи не позволяют изменять "
"историческую складскую оценку."

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_move__historical_cost_line_id
msgid "Historical Cost Recalculation"
msgstr "Исторический пересчёт себестоимости"

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__historical_effective_at
msgid "Stock Operation Date"
msgstr "Дата и время списания"

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_cost_recompute__historical_evidence
msgid "Historical Evidence"
msgstr "Данные проверки истории"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Historical FIFO returned an invalid valuation."
msgstr "Исторический расчёт FIFO вернул недопустимую стоимость."

#. module: pos_historical_stock_writeoff
#: model:res.groups.privilege,name:pos_historical_stock_writeoff.privilege_historical_stock
msgid "Historical POS Stock"
msgstr "Исторические списания кассы"

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__historical_session_id
msgid "Historical Session"
msgstr "Старая смена"

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_stock_picking__historical_source_snapshot
msgid "Historical Source Snapshot"
msgstr "Снимок исходного чека"

#. module: pos_historical_stock_writeoff
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.pos_order_historical_form
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.pos_session_historical_form
msgid "Historical Stock"
msgstr "Исторические списания"

#. module: pos_historical_stock_writeoff
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.pos_order_historical_form
#: model_terms:ir.ui.view,arch_db:pos_historical_stock_writeoff.stock_picking_historical_form
msgid "Historical Stock Write-off"
msgstr "Историческое списание"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/cost_recompute.py:0
msgid ""
"Historical Stock Write-off cannot be removed while completed historical "
"documents exist."
msgstr ""
"Модуль исторического списания нельзя удалить, пока существуют проведённые "
"исторические документы."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/pos_order.py:0
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_cost_recompute__historical_picking_ids
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_order__historical_picking_ids
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_session__historical_picking_ids
#: model:ir.model.fields.selection,name:pos_historical_stock_writeoff.selection__pos_cost_recompute__selection_type__historical
msgid "Historical Stock Write-offs"
msgstr "Исторические списания"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/pos_order.py:0
msgid "Historical consumption requires a direct delivery operation."
msgstr ""
"Для исторического списания необходима прямая отгрузка со склада покупателю."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid ""
"Historical consumption would cause a stock shortage for %(product)s on "
"%(date)s."
msgstr ""
"Историческое списание приведёт к недостатку товара %(product)s на %(date)s."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/cost_recompute.py:0
msgid "Historical cost audit links are server-managed."
msgstr "Связи с историей пересчёта стоимости устанавливаются сервером."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Historical details require a document prepared from a receipt."
msgstr ""
"Исторические реквизиты доступны только в документе, подготовленном из чека."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid ""
"Historical documents cannot be copied. Prepare them from an eligible "
"receipt."
msgstr ""
"Исторические списания нельзя копировать. Подготовьте документ из подходящего"
" чека."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid ""
"Historical receipt, session and stock locations must belong to the same "
"company and POS."
msgstr ""
"Исходный чек, смена и складские размещения должны соответствовать одной "
"компании и кассе."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Historical receipts must have a positive recorded value."
msgstr "Исторические приходы должны иметь положительную учётную стоимость."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/cost_recompute.py:0
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Historical recomputation cannot include this POS source: %(reason)s"
msgstr "Этот чек нельзя включить в исторический пересчёт: %(reason)s"

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/cost_recompute.py:0
msgid ""
"Historical recomputation includes all affected products and subsequent "
"operations. Use All Matching Lines without additional product or POS "
"filters."
msgstr ""
"Исторический пересчёт охватывает все затронутые товары и последующие "
"операции. Выберите все подходящие строки без дополнительных фильтров по "
"товарам и кассам."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid "Historical source links and audit data are server-managed."
msgstr "Исторические связи и сведения о проведении устанавливаются сервером."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_integrity.py:0
msgid ""
"Historical stock dimensions and values are managed by the historical "
"actions."
msgstr ""
"Реквизиты и стоимость исторических движений изменяются только специальными "
"действиями списания и пересчёта."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_integrity.py:0
msgid "Historical stock movements cannot be copied."
msgstr "Исторические складские движения нельзя копировать."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/history.py:0
msgid "Historical stock operations require dedicated permission."
msgstr "Для исторических складских операций необходимо отдельное разрешение."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/pos_order.py:0
msgid ""
"Historical stock preparation requires a draft or cancelled receipt without "
"payments, deliveries, invoices, returns, corrections or debt settlement."
msgstr ""
"Для исторического списания нужен черновой или отменённый чек без оплат, "
"отгрузок, счетов, возвратов, исправлений и погашений долга."

#. module: pos_historical_stock_writeoff
#. odoo-python
#: code:addons/pos_historical_stock_writeoff/models/stock_picking.py:0
msgid ""
"Historical stock processing did not complete without unsupported side "
"effects."
msgstr ""
"Историческое списание не завершено полностью либо создало неподдержанные "
"связанные операции."

#. module: pos_historical_stock_writeoff
#: model:ir.model.fields,field_description:pos_historical_stock_writeoff.field_pos_cost_recompute__historical_cutoff
msgid "History Through"
msgstr "История по"

