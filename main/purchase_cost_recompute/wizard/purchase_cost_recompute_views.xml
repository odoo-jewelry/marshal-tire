<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_cost_recompute_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.cost.recompute.wizard.form</field>
        <field name="model">purchase.cost.recompute.wizard</field>
        <field name="arch" type="xml">
            <form string="Include Taxes in Prices and Recompute Costs">
                <group>
                    <field name="order_ids" widget="many2many_tags" options="{'no_open': True}"/>
                </group>
                <p>Include the selected purchases' taxes in unit prices, round prices to two decimal places and remove the included taxes from the lines. Recompute receipt, issue, return and POS costs. Rounding may change the purchase totals.</p>
                <footer>
                    <button name="action_apply" type="object" string="Recompute Costs" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_cost_recompute_wizard_action" model="ir.actions.act_window">
        <field name="name">Include Taxes in Prices and Recompute Costs</field>
        <field name="res_model">purchase.cost.recompute.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="purchase_cost_recompute_wizard_view_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_manager')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>
