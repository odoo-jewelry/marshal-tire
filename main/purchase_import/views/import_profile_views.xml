<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_import_profile_view_list" model="ir.ui.view">
        <field name="name">purchase.import.profile.list</field>
        <field name="model">purchase.import.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="header_row"/>
                <field name="data_row"/>
                <field name="unmatched_policy"/>
                <field name="creation_mode" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="purchase_import_profile_view_form" model="ir.ui.view">
        <field name="name">purchase.import.profile.form</field>
        <field name="model">purchase.import.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="header_row"/>
                            <field name="data_row"/>
                            <field name="sheet"/>
                            <field name="max_rows"/>
                            <field name="max_file_size_mb"/>
                        </group>
                        <group string="CSV">
                            <field name="encoding"/>
                            <field name="separator"/>
                            <field name="quoting"/>
                            <field name="decimal_separator"/>
                            <field name="thousand_separator"/>
                        </group>
                    </group>
                    <group string="Unmatched Products">
                        <group>
                            <field name="unmatched_policy"/>
                            <field name="creation_mode" invisible="unmatched_policy != 'create'"/>
                            <field name="variant_template_id"
                                   invisible="unmatched_policy != 'create' or creation_mode != 'variant'"/>
                        </group>
                        <group invisible="unmatched_policy != 'create' or creation_mode != 'standalone'">
                            <field name="default_product_type"/>
                            <field name="default_is_storable" invisible="default_product_type != 'consu'"/>
                            <field name="default_categ_id"/>
                            <field name="default_uom_id"/>
                            <field name="default_purchase_uom_id"/>
                            <field name="default_tracking" invisible="not default_is_storable"/>
                            <field name="default_purchase_ok"/>
                            <field name="default_sale_ok"/>
                            <field name="default_supplier_tax_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Column Mapping">
                            <field name="mapping_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_column"/>
                                    <field name="target"/>
                                    <field name="attribute_id" invisible="target != 'attribute'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Product Lookup">
                            <field name="lookup_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="lookup_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_import_profile_action" model="ir.actions.act_window">
        <field name="name">Purchase Import Profiles</field>
        <field name="res_model">purchase.import.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="purchase_import_profile_menu"
              name="Import Profiles"
              parent="purchase.menu_purchase_config"
              action="purchase_import_profile_action"
              sequence="40"
              groups="purchase.group_purchase_manager"/>
</odoo>
