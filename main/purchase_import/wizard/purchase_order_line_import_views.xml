<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_line_import_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.order.line.import.wizard.form</field>
        <field name="model">purchase.order.line.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Purchase Lines">
                <header>
                    <button name="action_parse" type="object" string="Read File" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_parse" type="object" string="Reload File" class="btn-secondary" invisible="state == 'upload'"/>
                    <button name="action_preview" type="object" string="Validate" class="btn-primary" invisible="state == 'upload'"/>
                    <button name="action_apply" type="object" string="Import Lines" class="btn-primary" invisible="state != 'preview' or not preview_valid"/>
                    <field name="state" widget="statusbar" statusbar_visible="upload,mapping,preview"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="preview_valid" invisible="1"/>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="profile_id" options="{'no_create': True}"/>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="sheet"/>
                            <field name="available_sheets" invisible="not available_sheets"/>
                            <field name="header_row"/>
                            <field name="data_row"/>
                        </group>
                        <group string="CSV and Limits">
                            <field name="encoding"/>
                            <field name="separator"/>
                            <field name="quoting"/>
                            <field name="decimal_separator"/>
                            <field name="thousand_separator"/>
                            <field name="max_rows"/>
                            <field name="max_file_size_mb"/>
                        </group>
                    </group>
                    <group string="Unmatched Products">
                        <group>
                            <field name="unmatched_policy"/>
                            <field name="creation_mode" invisible="unmatched_policy != 'create'"/>
                            <field name="variant_template_id" invisible="unmatched_policy != 'create' or creation_mode != 'variant'"/>
                        </group>
                        <group invisible="unmatched_policy != 'create' or creation_mode != 'standalone'">
                            <field name="default_product_type"/>
                            <field name="default_is_storable" invisible="default_product_type != 'consu'"/>
                            <field name="default_categ_id"/>
                            <field name="default_uom_id"/>
                            <field name="default_purchase_uom_id"/>
                            <field name="default_tracking" invisible="not default_is_storable"/>
                            <field name="default_purchase_ok"/>
                            <field name="default_sale_ok"/>
                            <field name="default_supplier_tax_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Column Mapping" invisible="state == 'upload'">
                            <field name="mapping_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_index" column_invisible="True"/>
                                    <field name="source_column" readonly="1" force_save="1"/>
                                    <field name="target"/>
                                    <field name="attribute_id" invisible="target != 'attribute'"/>
                                </list>
                            </field>
                            <group groups="purchase.group_purchase_manager">
                                <field name="profile_name"/>
                                <button name="action_save_profile" type="object" string="Save as New Profile" class="btn-secondary"/>
                            </group>
                        </page>
                        <page string="Preview" invisible="state != 'preview'">
                            <group>
                                <field name="source_row_count"/>
                                <field name="error_count"/>
                            </group>
                            <field name="preview_ids" nolabel="1">
                                <list decoration-danger="status == 'error'" decoration-info="status == 'create'">
                                    <field name="source_row"/>
                                    <field name="status"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="planned_action" optional="show"/>
                                    <field name="product_name" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price"/>
                                    <field name="min_qty" optional="hide"/>
                                    <field name="supplier_code" optional="show"/>
                                    <field name="default_code" optional="hide"/>
                                    <field name="barcode" optional="hide"/>
                                    <field name="attribute_values" optional="show"/>
                                    <field name="error_message" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_order_line_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Purchase Lines</field>
        <field name="res_model">purchase.order.line.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
