<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.price.control</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="has_price_control_lines" invisible="True"/>
                <field name="has_price_updates" invisible="True"/>
                <button name="action_fill_current_prices" string="Fill Current Prices" type="object" invisible="not has_price_control_lines"/>
                <button name="action_update_all_prices" string="Update All" type="object" invisible="not has_price_updates"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='company_id']" position="after">
                <field name="company_currency_id" column_invisible="True"/>
                <field name="price_snapshot_initialized" column_invisible="True"/>
                <field name="price_update_required" column_invisible="True"/>
                <field name="planned_sale_price_manually_set" column_invisible="True"/>
                <field name="planned_sale_price_override" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="current_standard_price" optional="show" readonly="True" invisible="display_type or is_downpayment"/>
                <field name="current_markup" optional="show" readonly="True" invisible="display_type or is_downpayment"/>
                <field name="current_sale_price" optional="show" readonly="True" invisible="display_type or is_downpayment"/>
                <field name="planned_sale_price" optional="show" readonly="not price_snapshot_initialized" invisible="display_type or is_downpayment"/>
                <button name="action_update_product_prices" string="Update" type="object" icon="fa-refresh" invisible="not price_update_required"/>
            </xpath>
        </field>
    </record>
</odoo>
