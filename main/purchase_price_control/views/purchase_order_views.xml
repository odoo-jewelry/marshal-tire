<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.price.control</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='company_id']" position="after">
                <field name="company_currency_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="current_purchase_price" optional="hide" invisible="display_type or is_downpayment"/>
                <field name="current_sale_price" optional="hide" invisible="display_type or is_downpayment"/>
                <field name="current_markup" optional="show" invisible="display_type or is_downpayment"/>
                <field name="effective_purchase_price" optional="show" invisible="display_type or is_downpayment"/>
                <field name="planned_sale_price" optional="show" invisible="display_type or is_downpayment"/>
                <field name="save_prices"
                       optional="show"
                       readonly="state not in ('draft', 'sent')"
                       invisible="display_type or is_downpayment"
                       column_invisible="parent.state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
