<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_product_turnover_report.ProductStockTurnover">
        <div class="o_stock_product_turnover_report o_action">
            <div class="o_stock_product_turnover_report_header">
                <h2>Product stock turnover statement</h2>
                <p class="text-muted">Owned inventory-tracked products only. Historical values use the current recorded edition.</p>
            </div>
            <div class="o_stock_product_turnover_report_filters">
                <label>Company
                    <select class="form-select" t-on-change="onCompanyChange">
                        <t t-foreach="state.companies" t-as="company" t-key="company.id">
                            <option t-att-value="company.id" t-att-selected="company.id === state.options.company_id"><t t-esc="company.name"/></option>
                        </t>
                    </select>
                </label>
                <label>From
                    <input class="form-control" type="date" name="date_from" t-att-value="state.options.date_from" t-on-change="onDateChange"/>
                </label>
                <label>To
                    <input class="form-control" type="date" name="date_to" t-att-value="state.options.date_to" t-on-change="onDateChange"/>
                </label>
                <label>Warehouse
                    <select class="form-select" t-on-change="onWarehouseChange">
                        <option value="">All valued locations</option>
                        <t t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id">
                            <option t-att-value="warehouse.id" t-att-selected="warehouse.id === state.options.warehouse_id"><t t-esc="warehouse.name"/></option>
                        </t>
                    </select>
                </label>
                <label>Location
                    <input class="form-control" type="search" placeholder="Search location" t-att-value="state.query.location" t-on-input="(ev) => this.searchSelection('location', ev)"/>
                    <span t-if="state.options.location_id" class="o_stock_product_turnover_report_chip">
                        <t t-esc="state.labels.location"/>
                        <button type="button" t-on-click="() => this.removeSelection('location')" aria-label="Remove location">×</button>
                    </span>
                    <span class="o_stock_product_turnover_report_suggestions" t-if="state.suggestions.location.length">
                        <t t-foreach="state.suggestions.location" t-as="item" t-key="item.id">
                            <button type="button" t-on-click="() => this.chooseSelection('location', item)"><t t-esc="item.display_name"/></button>
                        </t>
                    </span>
                </label>
                <label class="o_stock_product_turnover_report_checkbox">
                    <input type="checkbox" t-att-checked="state.options.include_children" t-on-change="onChildrenChange"/>
                    Include child locations
                </label>
                <label>Products
                    <input class="form-control" type="search" placeholder="Search product" t-att-value="state.query.product" t-on-input="(ev) => this.searchSelection('product', ev)"/>
                    <span class="o_stock_product_turnover_report_suggestions" t-if="state.suggestions.product.length">
                        <t t-foreach="state.suggestions.product" t-as="item" t-key="item.id">
                            <button type="button" t-on-click="() => this.chooseSelection('product', item)"><t t-esc="item.display_name"/></button>
                        </t>
                    </span>
                    <span t-foreach="state.options.product_ids || []" t-as="id" t-key="id" class="o_stock_product_turnover_report_chip">
                        <t t-esc="state.labels.product[id] || id"/>
                        <button type="button" t-on-click="() => this.removeSelection('product', id)" aria-label="Remove product">×</button>
                    </span>
                </label>
                <label>Categories
                    <input class="form-control" type="search" placeholder="Search category" t-att-value="state.query.category" t-on-input="(ev) => this.searchSelection('category', ev)"/>
                    <span class="o_stock_product_turnover_report_suggestions" t-if="state.suggestions.category.length">
                        <t t-foreach="state.suggestions.category" t-as="item" t-key="item.id">
                            <button type="button" t-on-click="() => this.chooseSelection('category', item)"><t t-esc="item.display_name"/></button>
                        </t>
                    </span>
                    <span t-foreach="state.options.category_ids || []" t-as="id" t-key="id" class="o_stock_product_turnover_report_chip">
                        <t t-esc="state.labels.category[id] || id"/>
                        <button type="button" t-on-click="() => this.removeSelection('category', id)" aria-label="Remove category">×</button>
                    </span>
                </label>
                <label class="o_stock_product_turnover_report_checkbox">
                    <input type="checkbox" t-att-checked="state.options.show_fifo_receipts" t-on-change="onFifoChange"/>
                    Show FIFO receipts
                </label>
                <div class="o_stock_product_turnover_report_buttons">
                    <button class="btn btn-primary" type="button" t-on-click="applyFilters" t-att-disabled="state.loading">Apply</button>
                    <button class="btn btn-secondary" type="button" t-on-click="refresh" t-att-disabled="state.loading">Refresh</button>
                    <button class="btn btn-secondary" type="button" t-on-click="exportXlsx" t-att-disabled="state.loading || !state.report">XLSX</button>
                </div>
            </div>
            <t t-if="state.loading"><p>Calculating report…</p></t>
            <t t-if="state.report">
                <div class="o_stock_product_turnover_report_meta">
                    <span>Currency: <t t-esc="state.report.currency_name"/></span>
                    <span>Time zone: <t t-esc="state.report.timezone"/></span>
                    <span>Cutoff (UTC): <t t-esc="state.report.options.cutoff"/></span>
                    <span>Generated (UTC): <t t-esc="state.report.generated_at"/></span>
                    <span t-if="state.report.totals.incomplete" class="text-warning">Monetary totals are incomplete.</span>
                </div>
                <div class="o_stock_product_turnover_report_table_wrap">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th rowspan="2" data-field="default_code" t-on-click="sort">Reference</th>
                                <th rowspan="2" data-field="name" t-on-click="sort">Product</th>
                                <th rowspan="2">Unit</th>
                                <th rowspan="2" data-field="closing_unit_cost" t-on-click="sort">Unit cost</th>
                                <th colspan="2">Opening</th>
                                <th colspan="2">Incoming</th>
                                <th colspan="2">Outgoing</th>
                                <th rowspan="2" data-field="valuation_difference" t-on-click="sort">Valuation difference</th>
                                <th colspan="2">Closing</th>
                                <th rowspan="2">Diagnostics</th>
                            </tr>
                            <tr>
                                <th data-field="opening_qty" t-on-click="sort">Quantity</th>
                                <th data-field="opening_value" t-on-click="sort">Value</th>
                                <th data-field="incoming_qty" t-on-click="sort">Quantity</th>
                                <th data-field="incoming_value" t-on-click="sort">Value</th>
                                <th data-field="outgoing_qty" t-on-click="sort">Quantity</th>
                                <th data-field="outgoing_value" t-on-click="sort">Value</th>
                                <th data-field="closing_qty" t-on-click="sort">Quantity</th>
                                <th data-field="closing_value" t-on-click="sort">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pageRows" t-as="row" t-key="row.product_id">
                            <tr>
                                <td><t t-esc="row.default_code"/></td>
                                <td>
                                    <button t-if="row.fifo_receipts" class="btn btn-link px-1" type="button"
                                        aria-label="Toggle FIFO receipts" title="Toggle FIFO receipts"
                                        t-att-aria-expanded="state.expandedFifo[row.product_id] ? 'true' : 'false'"
                                        t-on-click="() => this.toggleFifo(row)">
                                        <t t-esc="state.expandedFifo[row.product_id] ? '−' : '+'"/>
                                    </button>
                                    <t t-esc="row.name"/>
                                </td>
                                <td><t t-esc="row.uom_name"/></td>
                                <td><t t-esc="formatMoney(row.closing_unit_cost)"/></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'opening')"><t t-esc="formatQuantity(row.opening_qty)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'opening')"><t t-esc="formatMoney(row.opening_value)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'incoming')"><t t-esc="formatQuantity(row.incoming_qty)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'incoming')"><t t-esc="formatMoney(row.incoming_value)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'outgoing')"><t t-esc="formatQuantity(row.outgoing_qty)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'outgoing')"><t t-esc="formatMoney(row.outgoing_value)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'difference')"><t t-esc="formatMoney(row.valuation_difference)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'closing')"><t t-esc="formatQuantity(row.closing_qty)"/></button></td>
                                <td><button class="btn btn-link" t-on-click="() => this.openDetails(row, 'closing')"><t t-esc="formatMoney(row.closing_value)"/></button></td>
                                <td><t t-foreach="row.diagnostics" t-as="diagnostic" t-key="diagnostic_index"><div class="text-warning"><t t-esc="diagnostic.message"/></div></t></td>
                            </tr>
                            <tr t-if="state.expandedFifo[row.product_id] &amp;&amp; row.fifo_receipts" class="o_stock_product_turnover_report_fifo_row">
                                <td colspan="14">
                                    <div t-foreach="['opening', 'closing']" t-as="boundary" t-key="boundary" class="mb-3">
                                        <h4><t t-esc="fifoBoundaryLabel(boundary)"/></h4>
                                        <p class="text-muted">Company FIFO valuation basis. Receipt amounts include all valued locations even when a warehouse or location is selected.</p>
                                        <t t-if="!row.fifo_receipts[boundary].applicable">
                                            <p>FIFO does not apply to this product.</p>
                                        </t>
                                        <t t-else="">
                                            <table class="table table-sm">
                                                <thead><tr><th>Date</th><th>Receipt document</th><th>Unit</th><th>Unit cost</th><th>Remaining quantity</th><th>Remaining value</th><th>Valuation lot</th></tr></thead>
                                                <tbody>
                                                    <tr t-foreach="row.fifo_receipts[boundary].receipts" t-as="receipt" t-key="receipt.move_id + ':' + (receipt.lot_id || 0)">
                                                        <td><t t-esc="receipt.date"/></td>
                                                        <td><button class="btn btn-link" t-on-click="() => this.openFifoReceipt(row, boundary, receipt)"><t t-esc="receipt.document_name"/></button></td>
                                                        <td><t t-esc="row.uom_name"/></td>
                                                        <td><t t-esc="formatMoney(receipt.unit_cost)"/></td>
                                                        <td><t t-esc="formatQuantity(receipt.quantity)"/></td>
                                                        <td><t t-esc="formatMoney(receipt.value)"/></td>
                                                        <td><t t-esc="receipt.lot_name"/></td>
                                                    </tr>
                                                    <tr t-if="row.fifo_receipts[boundary].diagnostics.length">
                                                        <td colspan="4" class="text-warning"><t t-esc="row.fifo_receipts[boundary].diagnostics.join('; ')"/></td>
                                                        <td><t t-esc="formatQuantity(row.fifo_receipts[boundary].unattributed_quantity)"/></td>
                                                        <td><t t-esc="formatMoney(row.fifo_receipts[boundary].unattributed_value)"/></td>
                                                        <td></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <p t-if="!row.fifo_receipts[boundary].receipts.length &amp;&amp; !row.fifo_receipts[boundary].diagnostics.length">No recorded FIFO receipts at this boundary.</p>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                            </t>
                            <tr class="fw-bold">
                                <td colspan="5">Total (<t t-esc="state.report.rows.length"/> products)</td>
                                <td><t t-esc="formatMoney(state.report.totals.opening_value)"/></td>
                                <td></td>
                                <td><t t-esc="formatMoney(state.report.totals.incoming_value)"/></td>
                                <td></td>
                                <td><t t-esc="formatMoney(state.report.totals.outgoing_value)"/></td>
                                <td><t t-esc="formatMoney(state.report.totals.valuation_difference)"/></td>
                                <td></td>
                                <td><t t-esc="formatMoney(state.report.totals.closing_value)"/></td>
                                <td></td>
                            </tr>
                            <tr t-foreach="state.report.unit_totals" t-as="subtotal" t-key="subtotal.uom_id">
                                <td colspan="4">Quantity subtotal: <t t-esc="subtotal.uom_name || subtotal.uom_id"/></td>
                                <td><t t-esc="formatQuantity(subtotal.opening_qty)"/></td>
                                <td></td>
                                <td><t t-esc="formatQuantity(subtotal.incoming_qty)"/></td>
                                <td></td>
                                <td><t t-esc="formatQuantity(subtotal.outgoing_qty)"/></td>
                                <td></td>
                                <td></td>
                                <td><t t-esc="formatQuantity(subtotal.closing_qty)"/></td>
                                <td colspan="2"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="o_stock_product_turnover_report_pagination">
                    <button class="btn btn-secondary" type="button" t-att-disabled="state.page === 1" t-on-click="() => state.page--">Previous</button>
                    <span><t t-esc="state.page"/> / <t t-esc="pageCount"/></span>
                    <button class="btn btn-secondary" type="button" t-att-disabled="state.page === pageCount" t-on-click="() => state.page++">Next</button>
                </div>
            </t>
            <div t-if="state.details" class="o_stock_product_turnover_report_detail">
                <div class="d-flex justify-content-between">
                    <h3>Detail: <t t-esc="detailLabel(state.details.section)"/></h3>
                    <button class="btn btn-secondary" type="button" t-on-click="() => state.details = null">Close</button>
                </div>
                <t t-if="state.details.section === 'difference'">
                    <div>Opening value: <t t-esc="formatMoney(state.details.explanation.opening_value)"/></div>
                    <div>Incoming value: <t t-esc="formatMoney(state.details.explanation.incoming_value)"/></div>
                    <div>Outgoing value: <t t-esc="formatMoney(state.details.explanation.outgoing_value)"/></div>
                    <div>Closing value: <t t-esc="formatMoney(state.details.explanation.closing_value)"/></div>
                    <div class="fw-bold">Valuation difference: <t t-esc="formatMoney(state.details.explanation.difference)"/></div>
                    <p><t t-esc="state.details.explanation.rule"/></p>
                    <div t-if="state.details.explanation.value_events.length">
                        <h4>Recorded valuation events</h4>
                        <div t-foreach="state.details.explanation.value_events" t-as="event" t-key="event.id">
                            <t t-esc="event.date"/> — <t t-esc="formatMoney(event.value)"/>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div>Quantity: <t t-esc="formatQuantity(state.details.explanation.quantity)"/></div>
                    <div>Value: <t t-esc="formatMoney(state.details.explanation.value)"/></div>
                    <t t-if="state.details.section === 'opening' || state.details.section === 'closing'">
                        <div>Company quantity: <t t-esc="formatQuantity(state.details.explanation.company_quantity)"/></div>
                        <div>Standard valuation quantity: <t t-esc="formatQuantity(state.details.explanation.standard_quantity)"/></div>
                        <div>Company standard value: <t t-esc="formatMoney(state.details.explanation.standard_value)"/></div>
                        <div t-foreach="state.details.explanation.lot_basis" t-as="lot" t-key="lot.lot_id">
                            <t t-esc="lot.lot_name"/>:
                            <t t-esc="formatQuantity(lot.selected_quantity)"/> /
                            <t t-esc="formatQuantity(lot.company_quantity)"/> —
                            <t t-esc="formatMoney(lot.standard_value)"/>
                        </div>
                    </t>
                    <p><t t-esc="state.details.explanation.rule"/></p>
                </t>
                <table class="table table-sm" t-if="state.details.lines.length">
                    <thead><tr><th>Date</th><th>Source</th><th>Destination</th><th>Lot/Serial Number</th><th>Quantity</th><th>Amount</th><th>Document</th></tr></thead>
                    <tbody>
                        <tr t-foreach="state.details.lines" t-as="line" t-key="line.source + ':' + (line.move_line_id || line.quant_id)">
                            <td>
                                <t t-esc="line.date || ''"/>
                                <small t-if="line.line_date &amp;&amp; line.line_date !== line.date" class="text-warning">
                                    Line date: <t t-esc="line.line_date"/>
                                </small>
                            </td>
                            <td><t t-esc="line.source_location || line.location || sourceLabel(line.source)"/></td>
                            <td><t t-esc="line.destination_location || ''"/></td>
                            <td><t t-esc="line.lot_name"/></td>
                            <td><t t-esc="formatQuantity(line.quantity)"/></td>
                            <td><t t-esc="line.amount === undefined ? '' : formatMoney(line.amount)"/></td>
                            <td><button t-if="line.document_id" class="btn btn-link" type="button" t-on-click="() => this.openDocument(line)"><t t-esc="line.document_name"/></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
